<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      The MSTest runner is the entry point of the test project; this host supplies its own Main
      that registers the test assembly with the Microsoft.Testing.Platform builder, so the
      generated entry point is switched off.
      -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>

    <!--
      The test project and the command-line project it references are executables that are
      consumed here purely as libraries, so the self-contained executable check does not apply.
      -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>

    <!--
      Ahead-of-time compilation requires the trimming step. Only assemblies marked trimmable are
      trimmed (partial mode), so the test framework and the test assemblies, which are located
      and invoked through reflection, stay whole. Their trim warnings are reported as warnings:
      the host is a test runner, not a trim-compatible library.
      -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>

    <!--
      The tests deserialize their JSON fixtures reflectively; a trimmed publish switches
      reflection-based serialization off unless it is switched back on here.
      -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>

    <!--
      Not part of the locked-restore solution build: the implicit browser-wasm package graph
      moves with every SDK release, so a committed lock file would churn without adding integrity.
      -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>

    <!--
      The publish location is stated explicitly: the WebAssembly SDK reports a publish directory
      that includes the runtime identifier at evaluation time but writes the bundle without it.
      The value is absolute and normalized for the host operating system because the workflow
      reads it from the repository root, where a project-relative path would name the wrong
      directory.
      -->
    <PublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'bin', '$(Configuration)', '$(TargetFramework)', 'publish'))</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The test assembly is loaded by name at run time, so nothing in the host references it
      statically; rooting it keeps it and everything it uses through the trimming step.
      -->
    <TrimmerRootAssembly Include="Lumoin.Veridical.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TestProjectDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'Lumoin.Veridical.Tests'))</TestProjectDirectory>
    <FixtureStagingDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'wwwroot', 'fixtures'))</FixtureStagingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The tests read fixture files from disk at the relative paths the native test project
      copies them to, and the files are not part of the test assembly. VfsPath is the path each
      file takes inside the runtime's in-memory file system. The folders are the ones the test
      project copies to its output directory, which tests resolve against the application base
      directory, plus the sample credentials and anchor outputs under TestMaterial, which tests
      resolve against the working directory; both resolve to the root of the virtual file system.
      -->
    <WasmFixtureSource Include="$(TestProjectDirectory)Spartan\Fixtures\**\*" VfsPath="Spartan/Fixtures/%(RecursiveDir)%(Filename)%(Extension)" />
    <WasmFixtureSource Include="$(TestProjectDirectory)ConstraintSystems\Interop\Circom\Fixtures\**\*" VfsPath="ConstraintSystems/Interop/Circom/Fixtures/%(RecursiveDir)%(Filename)%(Extension)" />
    <WasmFixtureSource Include="$(TestProjectDirectory)ConstraintSystems\Interop\ZkInterface\Fixtures\**\*" VfsPath="ConstraintSystems/Interop/ZkInterface/Fixtures/%(RecursiveDir)%(Filename)%(Extension)" />
    <WasmFixtureSource Include="$(TestProjectDirectory)Cryptography\Wycheproof\Fixtures\**\*" VfsPath="Cryptography/Wycheproof/Fixtures/%(RecursiveDir)%(Filename)%(Extension)" />
    <WasmFixtureSource Include="$(TestProjectDirectory)TestMaterial\**\*" VfsPath="TestMaterial/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="StageWasmFixtures" BeforeTargets="ResolveProjectStaticWebAssets">
    <!--
      The virtual file system item only accepts files that are static web assets, and the
      discovered ones are the files under wwwroot, so the fixtures are copied into the
      generated wwwroot/fixtures folder first. The copy happens before the assets are
      resolved, so the files are picked up as content in the same build.
      -->
    <Copy SourceFiles="@(WasmFixtureSource)" DestinationFiles="@(WasmFixtureSource->'$(FixtureStagingDirectory)%(VfsPath)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="$(FixtureStagingDirectory)**\*" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeFixturesInFileSystem" BeforeTargets="ComputeWasmVfs">
    <!--
      The item names each file by its path relative to wwwroot, which is how the static web
      asset for it is identified, and TargetPath gives the path inside the virtual file system.
      -->
    <ItemGroup>
      <WasmFilesToIncludeInFileSystem Include="fixtures/$([System.String]::Copy('%(WasmFixtureSource.VfsPath)').Replace('\', '/'))" TargetPath="/$([System.String]::Copy('%(WasmFixtureSource.VfsPath)').Replace('\', '/'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Lumoin.Veridical.Tests\Lumoin.Veridical.Tests.csproj" />
  </ItemGroup>

</Project>
