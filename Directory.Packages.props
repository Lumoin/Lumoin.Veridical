<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Library">
    <!-- Shared Lumoin bedrock: the type-keyed Tag and the secure (Managed/Pinned/Native) byte memory pool,
         aligned across the Lumoin family so tagged/pooled crypto material crosses package boundaries without
         a duplicate-type impedance mismatch. -->
    <PackageVersion Include="Lumoin.Base" Version="0.0.14" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.12" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.1" />
    <!-- Benchmarks-only: head-to-head comparison vs. the xoofx
         native BLAKE3 binding. Referenced only from the benchmarks
         project; src/ and Lumoin.Veridical.Tests carry no dependency
         on it. -->
    <PackageVersion Include="Blake3" Version="3.0.2" />
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="LiquidTestReports.Markdown" Version="2.0.0-beta.6" />
    <PackageVersion Include="Lumoin.Veritas.Cbor" Version="0.0.1" />
    <!-- The Lumoin.Veridical CLI / MCP tool. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0-rc.1.26425.128" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <!-- Fuzzing-only and inert by default: Lumoin.Veridical.Fuzzing references SharpFuzz only under
         -p:EnableSharpFuzz=true, which also requires adding the SharpFuzz package owner to the
         NuGet.config trusted-signers <owners> allowlist. See test/Lumoin.Veridical.Fuzzing/FUZZING.md.
         Verify the latest version on activation. -->
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>
</Project>